{
  "name": "PIVC Executive Dashboard Theme",
  "dataColors": [
    "#0078D4",
    "#D83B01",
    "#107C41",
    "#5C2D91",
    "#00B7C3",
    "#FF8C00",
    "#E3008C",
    "#004E8C",
    "#744DA9",
    "#2D7D9A"
  ],
  "background": "#F4F6F9",
  "foreground": "#252B3B",
  "tableAccent": "#0078D4",
  "visualStyles": {
    "*": {
      "*": {
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#F4F6F9" } }
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E5E9F0" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "transparency": 92,
            "preset": "Custom",
            "position": "Outer",
            "angle": 135,
            "distance": 3,
            "blur": 8
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0F2042" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "alignment": "Left"
          }
        ],
        "subTitle": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#605E5C" } },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontFamily": "Segoe UI Bold",
            "fontSize": 24,
            "color": { "solid": { "color": "#0F2042" } }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "color": { "solid": { "color": "#605E5C" } }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#0F2042" } }
          }
        ],
        "values": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#0F2042" } }
          }
        ],
        "values": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ]
      }
    }
  }
}
